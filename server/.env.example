# MongoDB connection string. Leave unset to use a throwaway in-memory MongoDB.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tefdatabase

# Port the API listens on.
PORT=4000

# Comma-separated origins allowed to call the API. Unset allows any origin.
# CORS_ORIGINS=http://localhost:3000,https://your-site.vercel.app

# When set, every mutation needs the header "Authorization: Bearer <ADMIN_TOKEN>".
# ADMIN_TOKEN=change-me

# Seed the sample data on startup when the database is empty (default true).
# SEED_ON_START=false
