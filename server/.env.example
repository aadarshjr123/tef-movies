# MongoDB connection string. Optional in development (an in-memory MongoDB is
# used when unset); required in production.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tefmovies

PORT=4000

# Comma-separated origins allowed by CORS. Unset allows any origin.
# CORS_ORIGINS=http://localhost:5173,https://your-site.vercel.app

# Bearer token required for mutations (at least 16 characters). Required in production.
# ADMIN_TOKEN=

# Seed sample data on startup when the database is empty (default true).
# SEED_ON_START=false

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Requests per minute per IP on /graphql.
# RATE_LIMIT_PER_MINUTE=300
